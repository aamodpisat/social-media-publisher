# Copy to .env and fill in values. Never commit .env.

# LLM — any OpenAI-compatible API (OpenAI, Groq, Together, OpenRouter, Ollama, …)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Schedule — used when the UI has no posting days selected
# Default Tue/Wed/Thu: midweek peak for Instagram + Facebook reach.
POSTING_DAYS=sat,sun
POSTING_TIME=11:00
POSTING_TIMEZONE=Asia/Kolkata

# Meta Graph API (Page + Instagram Professional)
META_GRAPH_VERSION=v21.0
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=

# Contentstack Assets: upload selected media and use the returned public asset URL.
# Classic Content Management API asset upload uses the Stack API key and Management Token.
CONTENTSTACK_API_KEY=
CONTENTSTACK_MANAGEMENT_TOKEN=
# Regional CMA host; choose the host for your data region.
CONTENTSTACK_API_HOST=https://api.contentstack.io
# CDN hosts returned for assets (CMA response may provide the canonical URL).
CONTENTSTACK_IMAGE_HOST=https://images.contentstack.io
CONTENTSTACK_VIDEO_HOST=https://assets.contentstack.io

# Local media folders
MEDIA_ROOT=/Users/aamodpisat/Documents/Instagram Photos & Reels
