# Fill these in locally. Never paste your secrets into a chat.
OPENAI_API_KEY=
GOOGLE_DRIVE_FOLDER_ID=
# Storage-only credentials. Drive file bytes use the user OAuth login below, not this key.
GCS_SERVICE_ACCOUNT_JSON=secrets/google-service-account.json
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v27.0
GCS_BUCKET_NAME=
STATE_PATH=data/processed_images.json

# Actual business context supplements the exact, unchanged system prompt.
BRAND_NAME=
BRAND_NICHE=
BRAND_AUDIENCE=
BRAND_VOICE=
BRAND_OFFER=
BRAND_CTA=
# One hashtag, including the #. Put quoted text after the equals sign.
BRAND_HASHTAG=

GOOGLE_DRIVE_POSTS_FOLDER_ID=

GOOGLE_DRIVE_STORIES_FOLDER_ID=

GOOGLE_DRIVE_REELS_FOLDER_ID=

INSTAGRAM_EXPECTED_USERNAME=
